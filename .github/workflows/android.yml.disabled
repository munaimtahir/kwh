# DISABLED: this workflow is not picked up by GitHub Actions because it lacks the
# .yml/.yaml extension (renamed from android.yml). Reason: this repo's checkout has no
# keystore secrets configured, so a CI-triggered assembleRelease/bundleRelease silently
# falls back to DEBUG signing (see app/build.gradle.kts) instead of failing loudly —
# producing an artifact that looks release-ready but can't be uploaded to Play Console.
#
# To re-enable: add the release keystore + credentials as repo secrets, wire them into
# a generated keystore.properties (or pass via -P/env) in the steps below, rename this
# file back to android.yml, and verify the produced APK is release-signed (e.g. via
# `apksigner verify --print-certs`) before trusting CI output for a Play Store upload.
name: Android Release Build

on:
  workflow_dispatch:  # Only runs when you trigger it manually

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: 17

      - name: Grant execute permission for Gradle wrapper
        run: chmod +x ./gradlew

      - name: Build Release APK
        run: ./gradlew assembleRelease

      - name: Build Release AAB
        run: ./gradlew bundleRelease

      - name: Upload APK artifact
        uses: actions/upload-artifact@v4
        with:
          name: app-release-apk
          path: app/build/outputs/apk/release/*.apk

      - name: Upload AAB artifact
        uses: actions/upload-artifact@v4
        with:
          name: app-release-aab
          path: app/build/outputs/bundle/release/*.aab
